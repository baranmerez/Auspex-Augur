{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auspex Augur",
  "version": "0.1.0",
  "identifier": "io.github.baranmerez.auspexaugur",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/prepare-ui.mjs",
    "beforeBuildCommand": "node scripts/prepare-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auspex Augur",
        "width": 1320,
        "height": 860,
        "minWidth": 420,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
